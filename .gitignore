cat > .gitignore <<'EOF'
# Environment secrets
.env
.env.*
!.env.example

# Python
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
htmlcov/

# Frontend
frontend/node_modules/
frontend/dist/

# Uploaded resumes and generated data
backend/uploads/
*.db
*.sqlite
*.sqlite3

# Editor and OS files
.vscode/
.idea/
.DS_Store
EOF